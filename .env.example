# Get TG_API_ID / TG_API_HASH from https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Create this bot with @BotFather - it's your control/admin bot
TG_BOT_TOKEN=123456:your_bot_token_here

# Your own numeric Telegram user ID (e.g. via @userinfobot) -
# the control bot only responds to this ID.
TG_ADMIN_ID=123456789

# Session file name for the userbot login (created on first run)
TG_USER_SESSION=user_session

# Optional: route the userbot connection through a SOCKS5 proxy.
# Leave PROXY_HOST empty/unset to connect directly.
PROXY_HOST=
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=
